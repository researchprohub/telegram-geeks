{
  "name": "telegram-geeks-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram Geeks desktop client (Electron + React + embedded backend)",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "check": "tsc --noEmit && vite build",
    "test": "vitest run",
    "dist": "electron-builder --win dir"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "axios": "^1.7.0",
    "lucide-react": "^0.460.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.telegramgeeks.desktop",
    "productName": "TelegramGeeks",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend"
      },
      {
        "from": "../telegram_layer",
        "to": "telegram_layer"
      },
      {
        "from": "../analytics_engine",
        "to": "analytics_engine"
      },
      {
        "from": "../anti_detection",
        "to": "anti_detection"
      },
      {
        "from": "../database_layer",
        "to": "database_layer"
      },
      {
        "from": "../contacts",
        "to": "contacts"
      },
      {
        "from": "../marketing",
        "to": "marketing"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  },
  "allowScripts": {}
}
