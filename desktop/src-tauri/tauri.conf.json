{
  "productName": "Telegram Geeks",
  "version": "0.1.0",
  "identifier": "com.telegramgeeks.desktop",
  "build": {
    "beforeDevCommand": "cd ..\\..\\backend && start /B python -m uvicorn app.main:app --host 127.0.0.1 --port 8002 && cd ..\\frontend && start /B npm run dev",
    "beforeBuildCommand": "cd ..\\frontend && npm run build",
    "frontendDist": "..\\frontend\\.next\\standalone\\frontend",
    "devUrl": "http://127.0.0.1:3000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Telegram Geeks",
        "width": 1280,
        "height": 800
      }
    ]
  }
}
