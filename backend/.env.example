# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tep
SQLALCHEMY_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
SESSION_STORAGE_PATH=./sessions

# JWT — MUST be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=${JWT_SECRET:?JWT_SECRET is required (min 32 chars)}
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15

# Cookie settings
COOKIE_SECURE=false          # true in production (HTTPS only)
COOKIE_SAMESITE=lax

# ─── AI PROVIDERS ─────────────────────────────────────────────
# Paid providers
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-key

# Free tier providers (no credit card required)
GROQ_API_KEY=gsk-your-groq-key
GOOGLE_API_KEY=your-google-api-key          # Google AI Studio (free)
NVIDIA_API_KEY=nvapi-your-nvidia-key        # NVIDIA NIM (free, 40 RPM, no daily cap)
CEREBRAS_API_KEY=cs-your-cerebras-key       # Cerebras (free, 30 RPM)
CLOUDFLARE_ACCOUNT_ID=your_cf_account_id    # Cloudflare Workers AI (free, 39 models)
CLOUDFLARE_API_KEY=your_cf_api_key
OPENROUTER_API_KEY=sk-or-your-openrouter-key # OpenRouter (35+ free models)
SILICONFLOW_API_KEY=your-siliconflow-key    # SiliconFlow (Qwen, DeepSeek free)
COHERE_API_KEY=your-cohere-key              # Cohere Command R+ (free)
MISTRAL_API_KEY=your-mistral-key            # Mistral AI (~1B tokens/mo free)

# Local inference
OLLAMA_BASE_URL=http://localhost:11434

# HuggingFace (optional)
HUGGINGFACE_API_KEY=hf-your-token

# ─── AI CONFIGURATION ─────────────────────────────────────────
# Default provider and model
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o-mini

# Fallback chain (ordered: try first, then next on failure)
AI_FALLBACK_CHAIN=openai,groq,nvidia,cerebras,ollama,openrouter,siliconflow,cohere,mistral,cloudflare,anthropic

# ─── RATE LIMITING ────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ─── PROXY ────────────────────────────────────────────────────
DEFAULT_PROXY_POOL_SIZE=20
PROXY_ROTATION_ENABLED=true

# ─── SAFETY ───────────────────────────────────────────────────
MAX_DAILY_MESSAGES_PER_ACCOUNT=50
FLOOD_WAIT_AUTO_RESUME=true
BAN_DETECTION_ENABLED=true

# ─── FRONTEND ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── LOGGING ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── METRICS ──────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PORT=9090
